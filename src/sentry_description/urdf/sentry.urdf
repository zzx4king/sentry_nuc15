<?xml version="1.0"?>
<robot name="sentry">

  <!-- 车体主体: 长方体 长0.53m(x) 宽0.49m(y) 高0.10m(z), base_link 原点位于底面中心 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.53 0.49 0.10"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.53 0.49 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- MID360 激光雷达, frame 与 livox_ros_driver2 发布的点云 frame_id 保持一致 -->
  <link name="livox_frame">
    <visual>
      <origin xyz="0 0 0.0345" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.069"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 雷达安装位置: 垂直于宽边的对称轴(y=0)上, 距前宽边 0.265-0.06=0.205m, 位于长方体顶面上方(z=0.10) -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="0.205 0 0.10" rpy="0 0 0"/>
  </joint>

</robot>
